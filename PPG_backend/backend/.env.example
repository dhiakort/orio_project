# Copier ce fichier vers .env et adapter les valeurs
# cp .env.example .env

# --- Base de données ---
# True = SQLite (db.sqlite3) — recommandé pour démarrer sans config PostgreSQL
# False = PostgreSQL (remplir DB_PASSWORD avec ton vrai mot de passe postgres)
USE_SQLITE=True

DB_NAME=orio_db
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe_postgres
DB_HOST=localhost
DB_PORT=5432

# --- Roadmap & Chatbot LLM (Groq) ---
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_votre_cle_ici
GROK_API_KEY=xai_votre_cle_grok_ici

# --- Django ---
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email (local console by default) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@orio.local
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
